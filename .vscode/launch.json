    "version": "0.2.0",
    "configurations": [
        {
            "name": "[root]Analyze all files",
            "cwd": "project_analyze",
            "program": "bin/project_analyze.dart",
            "request": "launch",
            "type": "dart",
            "args": [
                "--input=../generated/flutter",
                "--output=../generated",
            ],
        },
        {
            "name": "[root]Analyze only",
            "cwd": "project_analyze",
            "program": "bin/project_analyze.dart",
            "request": "launch",
            "type": "dart",
            "args": [
                "--input=../generated/flutter",
                "--output=../generated",
                "--filter=**/button.dart",
            ],
        },
        {
            "name": "[root]Clone",
            "cwd": "flutter_clone",
            "program": "bin/flutter_clone.dart",
            "request": "launch",
            "type": "dart",
            "args": [
                "--output=../flutter_example/generated",
                // "--widget=*Button",
                "--widget=DropdownButton",
            ],
        },
        {
            "name": "[rxflutter] Counter example",
            "cwd": "packages/rxflutter/example/counter",
